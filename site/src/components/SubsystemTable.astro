---
import StatusPill from "./StatusPill.astro";
import { subsystems, site } from "../data/site";
---

<section class="shell wrap">
  <div class="head">
    <p class="eyebrow">Repositories</p>
    <p class="tiny">{subsystems.length} pinned submodules · one source of truth per core</p>
  </div>
  <div class="card list">
    {subsystems.map((s) => (
      <a class="row" href={site.org + "/" + s.name}>
        <span class="name mono">{s.name}</span>
        <span class="owns muted">{s.owns}</span>
        <span class="st"><StatusPill status={s.status} /></span>
      </a>
    ))}
  </div>
  <p class="tiny note">A submodule reference is a pinned commit, not a copy. One commit in the meta-repository records a combination of repositories that is known to work together.</p>
</section>

<style>
  .wrap{padding-top:32px}
  .head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .list{overflow:hidden}
  .row{display:grid;grid-template-columns:220px 1fr 120px;gap:20px;align-items:center;padding:12px 16px;color:inherit;text-decoration:none;transition:background 150ms cubic-bezier(.22,1,.36,1)}
  .row + .row{border-top:1px solid var(--border-subtle)}
  .row:hover{background:var(--surface-hover);text-decoration:none}
  .name{font-size:13px;color:var(--text-accent)}
  .owns{font-size:13px}
  .st{text-align:right}
  .note{margin-top:12px;max-width:var(--measure)}
  @media (max-width:760px){.row{grid-template-columns:1fr auto;gap:6px}.owns{grid-column:1/-1}}
</style>
