---
import { site } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname;
const nav = [
  { href: base + "/", label: "Log", match: (p: string) => p.replace(/\/$/, "") === base },
  { href: base + "/entries", label: "Entries", match: (p: string) => p.includes("/entries") || p.includes("/log/") },
  { href: base + "/marks", label: "Marks", match: (p: string) => p.includes("/marks") },
  { href: base + "/system", label: "System", match: (p: string) => p.includes("/system") },
];
---

<header class="bar">
  <div class="shell inner">
    <a class="mark" href={base + "/"}>
      <img class="tile" src={base + "/brand-mark.svg"} alt="" width="20" height="20" />
      <span class="name">{site.title}</span>
      <span class="sub">Devblog</span>
    </a>
    <nav aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={["nav", n.match(path) && "on"]}>{n.label}</a>
      ))}
      <a class="nav" href={site.repo}>GitHub</a>
      <button class="theme" id="theme-toggle" type="button" aria-label="Switch theme"></button>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const paint = () => {
      const dark = document.documentElement.getAttribute("data-theme") === "dark";
      btn.textContent = dark ? "\u2600" : "\u25D1";
      btn.title = dark ? "Switch to light" : "Switch to dark";
    };
    btn.addEventListener("click", () => {
      const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("mark-devlog-theme", next); } catch (e) {}
      paint();
    });
    paint();
  })();
</script>

<style>
  .bar{position:sticky;top:0;z-index:10;background:var(--surface-card);border-bottom:1px solid var(--border-subtle)}
  .inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:52px}
  .mark{display:flex;align-items:center;gap:8px;color:var(--text-primary);text-decoration:none}
  .mark:hover{text-decoration:none}
  /* The mark file is white; light mode inverts it to black. */
  .tile{display:block;width:20px;height:20px;filter:invert(1)}
  :global(:root[data-theme="dark"]) .tile{filter:none}
  .name{font-size:13px;font-weight:500}
  .sub{font-size:12px;color:var(--text-tertiary)}
  nav{display:flex;align-items:center;gap:4px}
  .nav{padding:6px 10px;border-radius:8px;font-size:13px;color:var(--text-secondary);text-decoration:none;transition:background 150ms cubic-bezier(.22,1,.36,1),color 150ms}
  .nav:hover{background:var(--surface-hover);color:var(--text-primary);text-decoration:none}
  .nav.on{color:var(--accent);background:var(--accent-soft)}
  .theme{display:grid;place-items:center;width:30px;height:26px;margin-left:4px;padding:0;border:0;border-radius:8px;box-shadow:inset 0 0 0 1px var(--border-default);background:none;color:var(--text-secondary);font:inherit;font-size:13px;cursor:pointer;transition:background 150ms cubic-bezier(.22,1,.36,1),color 150ms}
  .theme:hover{background:var(--surface-hover);color:var(--text-primary)}
  @media (max-width:640px){.sub{display:none}}
</style>
