---
import StatusPill from "./StatusPill.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"log">[];
  /** Adds data-* attributes so the entries page can filter client-side. */
  filterable?: boolean;
  showMark?: boolean;
}
const { entries, filterable = false, showMark = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<div class="card list" id={filterable ? "log-list" : undefined}>
  {entries.map((e) => (
    <a
      class="row"
      href={base + "/log/" + e.slug}
      data-mark={e.data.mark}
      data-area={e.data.area}
      data-status={e.data.status}
      data-text={(e.data.title + " " + e.data.summary).toLowerCase()}
    >
      <span class="meta">
        <time class="tiny mono" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
        <span class="tiny">{e.data.area}</span>
      </span>
      <span>
        <span class="title">{e.data.title}</span>
        <span class="summary muted">{e.data.summary}</span>
      </span>
      <span class="right">
        {showMark && <span class="markchip mono">Mark {e.data.mark}</span>}
        <StatusPill status={e.data.status} />
        <span class="go" aria-hidden="true">→</span>
      </span>
    </a>
  ))}
  <p class="empty tiny" hidden>No entry matches those filters.</p>
</div>

<style>
  .list{overflow:hidden}
  .row{display:grid;grid-template-columns:120px 1fr auto;gap:20px;align-items:start;padding:16px;color:inherit;text-decoration:none;transition:background 150ms cubic-bezier(.22,1,.36,1)}
  .row + .row{border-top:1px solid var(--border-subtle)}
  .row:hover{background:var(--surface-hover);text-decoration:none}
  .row[hidden]{display:none}
  .meta{display:flex;flex-direction:column;gap:6px}
  .title{display:block;font-size:14px;font-weight:500;line-height:1.35}
  .summary{display:block;margin-top:6px;font-size:13px;max-width:64ch}
  .right{display:flex;align-items:center;justify-content:flex-end;gap:10px}
  .markchip{padding:3px 8px;border-radius:4px;font-size:12px;font-weight:500;background:var(--surface-sunken);color:var(--text-secondary)}
  .go{color:var(--text-tertiary);font-size:13px}
  .row:hover .go{color:var(--accent)}
  .empty{padding:48px 16px;text-align:center}
  @media (max-width:760px){.row{grid-template-columns:1fr;gap:10px}.meta{flex-direction:row;gap:10px;align-items:baseline}.right{justify-content:flex-start}.go{display:none}}
</style>
