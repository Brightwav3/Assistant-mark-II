---
const steps = [
  { label: "microphone", note: "PCM frameization" },
  { label: "AEC System", note: "echo + gate" },
  { label: "Realtime Core → Gemini Live", note: "session boundary" },
  { label: "tools / memory / state", note: "bounded, policy checked" },
  { label: "response audio", note: "barge-in cancellable" },
];
---

<section class="shell wrap">
  <p class="eyebrow">Active signal path</p>
  <ol class="card path">
    {steps.map((s, i) => (
      <li>
        <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
        <span class="l mono">{s.label}</span>
        <span class="tiny">{s.note}</span>
      </li>
    ))}
  </ol>
  <p class="tiny note">One speech route. The former local Scribe → Intelligence → Voice composition is retired from assistant-runtime — not a fallback, not a second mode.</p>
</section>

<style>
  .wrap{padding-top:32px}
  .path{list-style:none;margin:12px 0 0;padding:0;overflow:hidden}
  li{display:grid;grid-template-columns:32px 1fr auto;gap:16px;align-items:center;padding:12px 16px;font-size:13px}
  li + li{border-top:1px solid var(--border-subtle)}
  .n{color:var(--text-tertiary);font-size:12px}
  .l{color:var(--text-primary)}
  .note{margin-top:12px;max-width:var(--measure)}
  @media (max-width:640px){li{grid-template-columns:32px 1fr}li .tiny{grid-column:2}}
</style>
