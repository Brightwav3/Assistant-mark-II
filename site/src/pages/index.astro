---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Intro from "../components/Intro.astro";
import LogList from "../components/LogList.astro";
import SignalPath from "../components/SignalPath.astro";

const entries = (await getCollection("log")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout>
  <Intro total={entries.length} />
  <section class="shell">
    <div class="head">
      <p class="eyebrow">Latest entries</p>
      <a class="tiny" href={base + "/entries"}>All {entries.length} →</a>
    </div>
    <LogList entries={entries.slice(0, 3)} />
  </section>
  <SignalPath />
</BaseLayout>

<style>
  .head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
</style>
