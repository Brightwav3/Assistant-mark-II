---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { marks, phasePill } from "../../data/marks";

const entries = await getCollection("log");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const countOf = (id: string) => entries.filter((e) => e.data.mark === id).length;
---

<BaseLayout title="The Marks" description="The Marks describe technological evolution, not repository versions.">
  <section class="shell head">
    <p class="eyebrow">The Marks</p>
    <h1>The Marks describe technological evolution, not repository versions.</h1>
    <p class="muted lede">
      Each mark asks one question and is finished when that question has an answer. Open a mark to
      read its scope and the entries filed under it.
    </p>
  </section>

  <section class="shell grid">
    {marks.map((m) => {
      const n = countOf(m.id);
      const [bg, fg] = phasePill[m.phase];
      return (
        <a class:list={["tile", m.phase === "Active" && "live"]} href={base + "/marks/" + m.id.toLowerCase()}>
          <div class="top">
            <span class="mono id">{m.label}</span>
            <span class="pill" style={`background:${bg};color:${fg}`}>
              <span class="dot" aria-hidden="true"></span>{m.phase}
            </span>
          </div>
          <span class="name">{m.name}</span>
          <span class="q muted">{m.question}</span>
          <span class="count tiny mono">{n === 1 ? "1 entry" : n + " entries"}</span>
        </a>
      );
    })}
  </section>
</BaseLayout>

<style>
  .head{padding:40px 0 0}
  h1{margin-top:12px;max-width:26ch}
  .lede{margin-top:12px;max-width:var(--measure)}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding-top:24px}
  .tile{display:flex;flex-direction:column;gap:12px;padding:20px;background:var(--surface-card);border:1px solid var(--border-subtle);border-radius:16px;color:inherit;text-decoration:none;transition:background 150ms cubic-bezier(.22,1,.36,1)}
  .tile:hover{background:var(--surface-hover);text-decoration:none}
  .tile.live{border-color:var(--accent)}
  .top{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .id{font-size:13px}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:3px 8px;border-radius:4px;font-size:12px;font-weight:500}
  .dot{width:6px;height:6px;border-radius:999px;background:currentColor}
  .name{font-size:14px;font-weight:500;line-height:1.35}
  .q{font-size:13px}
  .count{margin-top:auto}
  @media (max-width:860px){.grid{grid-template-columns:1fr}}
</style>
