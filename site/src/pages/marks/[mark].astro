---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LogList from "../../components/LogList.astro";
import { marks, phasePill, type Mark } from "../../data/marks";

export async function getStaticPaths() {
  return marks.map((mark) => ({ params: { mark: mark.id.toLowerCase() }, props: { mark } }));
}

type Props = { mark: Mark };
const { mark } = Astro.props;
const all = await getCollection("log");
const entries = all
  .filter((e: CollectionEntry<"log">) => e.data.mark === mark.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [bg, fg] = phasePill[mark.phase];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={mark.label} description={mark.question}>
  <section class="shell head">
    <a class="back tiny" href={base + "/marks"}>← All marks</a>
    <div class="meta">
      <span class="tiny mono">{mark.label}</span>
      <span class="pill" style={`background:${bg};color:${fg}`}>
        <span class="dot" aria-hidden="true"></span>{mark.phase}
      </span>
    </div>
    <h1>{mark.name}</h1>
    <p class="muted lede">{mark.question}</p>
  </section>

  <section class="shell split">
    <div class="card prose">
      {mark.blocks.map((b) =>
        b.kind === "pre" ? <pre>{b.text}</pre> : <p>{b.text}</p>
      )}
    </div>
    <dl class="facts">
      {mark.facts.map((x) => (
        <div>
          <dt class="eyebrow">{x.label}</dt>
          <dd class="mono">{x.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="shell entries">
    <div class="ehead">
      <p class="eyebrow">Entries under this mark</p>
      <p class="tiny">{entries.length === 1 ? "1 entry" : entries.length + " entries"}</p>
    </div>
    {entries.length > 0 ? (
      <LogList entries={entries} />
    ) : (
      <div class="card blank">
        <span class="glyph" aria-hidden="true">·</span>
        <p class="tiny">Nothing filed yet — this mark is out of current scope.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .head{padding:40px 0 0}
  .back{color:var(--text-secondary);text-decoration:none}
  .meta{display:flex;align-items:center;gap:12px;margin-top:20px}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:3px 8px;border-radius:4px;font-size:12px;font-weight:500}
  .dot{width:6px;height:6px;border-radius:999px;background:currentColor}
  h1{margin-top:10px}
  .lede{margin-top:10px;max-width:var(--measure)}
  .split{display:grid;grid-template-columns:1.4fr 1fr;gap:16px;align-items:start;padding-top:24px}
  .prose{padding:24px 28px}
  .prose p{font-size:14px;color:var(--text-secondary);max-width:var(--measure)}
  .prose p + p,.prose pre{margin-top:16px}
  .prose pre{padding:16px;background:var(--surface-sunken);border:1px solid var(--border-subtle);border-radius:8px;overflow-x:auto;font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;line-height:1.5;color:var(--text-secondary)}
  .facts{display:grid;gap:1px;margin:0;padding:0;background:var(--border-subtle);border:1px solid var(--border-subtle);border-radius:16px;overflow:hidden}
  .facts > div{background:var(--surface-card);padding:14px 16px}
  dd{margin:6px 0 0;font-size:13px}
  .entries{padding-top:32px}
  .ehead{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .blank{display:flex;flex-direction:column;align-items:center;gap:12px;padding:48px 16px}
  .glyph{display:grid;place-items:center;width:96px;height:96px;border-radius:16px;background:var(--surface-sunken);color:var(--text-tertiary);font-size:24px}
  @media (max-width:860px){.split{grid-template-columns:1fr}}
</style>
