---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusPill from "../../components/StatusPill.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("log")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, newer: entries[i - 1] ?? null, older: entries[i + 1] ?? null },
  }));
}

type Props = {
  entry: CollectionEntry<"log">;
  newer: CollectionEntry<"log"> | null;
  older: CollectionEntry<"log"> | null;
};
const { entry, newer, older } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmt = entry.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="shell post">
    <a class="back tiny" href={base + "/entries"}>← All entries</a>
    <div class="meta">
      <span class="eyebrow">{entry.data.area}</span>
      <span class="tiny mono">{fmt}</span>
      <a class="markchip mono" href={base + "/marks/" + entry.data.mark.toLowerCase()}>Mark {entry.data.mark}</a>
      <StatusPill status={entry.data.status} />
    </div>
    <h1>{entry.data.title}</h1>
    <p class="muted summary">{entry.data.summary}</p>
    <div class="card prose"><Content /></div>

    <nav class="pager" aria-label="More entries">
      {older && (
        <a class="card step" href={base + "/log/" + older.slug}>
          <span class="tiny">← Older</span>
          <span class="t">{older.data.title}</span>
        </a>
      )}
      {newer && (
        <a class="card step right" href={base + "/log/" + newer.slug}>
          <span class="tiny">Newer →</span>
          <span class="t">{newer.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .post{padding:40px 0 0;max-width:860px}
  .back{text-decoration:none;color:var(--text-secondary)}
  .meta{display:flex;align-items:center;gap:12px;margin-top:20px;flex-wrap:wrap}
  .markchip{padding:3px 8px;border-radius:4px;font-size:12px;font-weight:500;color:var(--text-secondary);text-decoration:none;box-shadow:inset 0 0 0 1px var(--border-default)}
  .markchip:hover{background:var(--surface-hover);text-decoration:none}
  h1{margin-top:10px}
  .summary{margin-top:10px;max-width:var(--measure)}
  .prose{margin-top:24px;padding:24px 28px}
  .prose :global(p),.prose :global(li){font-size:14px;color:var(--text-secondary);max-width:var(--measure)}
  .prose :global(p + p),.prose :global(ul),.prose :global(ol),.prose :global(table){margin-top:16px}
  .prose :global(li){margin-top:6px}
  .prose :global(strong){color:var(--text-primary);font-weight:500}
  .prose :global(code){font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:13px;color:var(--text-primary);background:var(--surface-sunken);border-radius:4px;padding:1px 5px}
  .prose :global(pre){margin-top:16px;padding:16px;background:var(--surface-sunken);border:1px solid var(--border-subtle);border-radius:8px;overflow-x:auto}
  .prose :global(pre code){background:none;padding:0;font-size:12px;line-height:1.5;color:var(--text-secondary)}
  .prose :global(table){width:100%;border-collapse:collapse;font-size:13px}
  .prose :global(th),.prose :global(td){text-align:left;padding:10px 8px;border-bottom:1px solid var(--border-subtle);vertical-align:top;color:var(--text-secondary)}
  .prose :global(th){font-weight:500;color:var(--text-primary)}
  .pager{display:flex;gap:12px;margin-top:16px}
  .step{flex:1;display:flex;flex-direction:column;gap:4px;padding:14px 16px;text-decoration:none;color:inherit;transition:background 150ms cubic-bezier(.22,1,.36,1)}
  .step:hover{background:var(--surface-hover);text-decoration:none}
  .step.right{text-align:right}
  .t{font-size:13px;font-weight:500}
  @media (max-width:720px){.post{padding-top:28px}.prose{padding:20px}.pager{flex-direction:column}.step.right{text-align:left}}
</style>
